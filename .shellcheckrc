# scripts source lib.sh next to them
external-sources=true
source-path=SCRIPTDIR
# source (vs POSIX .) is the established convention across the scripts and works fine on the target's ash
disable=SC3046
# set by the scripts that source these ones, which shellcheck can't follow
disable=SC1091,SC2154
# local and source work on the console's ash
disable=SC3043,SC3051
# [ ] with ==, which the console's ash accepts
disable=SC3014
