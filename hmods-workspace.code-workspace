{
  "folders": [
    {
      "name": "hmods-workspace",
      "path": "."
    }
  ],
  "settings": {
    "files.autoSave": "off",
    "[shellscript]": {
      "editor.defaultFormatter": "foxundermoon.shell-format",
      "editor.formatOnSave": false,
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false
    },
    "editor.formatOnSave": false,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.renderWhitespace": "all",
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "shellformat.flag": "-i 2 -ci",
    "search.exclude": {
      "export/**": true,
      ".cache/**": true,
      "**/out/**": true,
      "**/local/**": true,
      "**/vendor/**": true
    },
    "files.watcherExclude": {
      ".cache/**": true,
      "**/local/**": true
    },
    "window.zoomLevel": 0,
    "files.associations": {
      "b[0-9]*": "shellscript",
      "p[0-9]*": "shellscript",
      "om_*": "shellscript",
      "install": "shellscript",
      "uninstall": "shellscript",
      "chmenu": "shellscript",
      "fontfix": "shellscript",
      "c[0-9]*": "properties",
      "iosfwd": "cpp",
      "atomic": "cpp",
      "cctype": "cpp",
      "chrono": "cpp",
      "cmath": "cpp",
      "compare": "cpp",
      "concepts": "cpp",
      "cstddef": "cpp",
      "cstdint": "cpp",
      "cstdio": "cpp",
      "cstdlib": "cpp",
      "cstring": "cpp",
      "cwchar": "cpp",
      "exception": "cpp",
      "fstream": "cpp",
      "initializer_list": "cpp",
      "ios": "cpp",
      "iostream": "cpp",
      "istream": "cpp",
      "iterator": "cpp",
      "limits": "cpp",
      "list": "cpp",
      "map": "cpp",
      "memory": "cpp",
      "new": "cpp",
      "ostream": "cpp",
      "ratio": "cpp",
      "sstream": "cpp",
      "stdexcept": "cpp",
      "streambuf": "cpp",
      "string": "cpp",
      "system_error": "cpp",
      "thread": "cpp",
      "tuple": "cpp",
      "type_traits": "cpp",
      "typeinfo": "cpp",
      "utility": "cpp",
      "vector": "cpp",
      "xfacet": "cpp",
      "xiosbase": "cpp",
      "xlocale": "cpp",
      "xlocinfo": "cpp",
      "xlocnum": "cpp",
      "xmemory": "cpp",
      "xstddef": "cpp",
      "xstring": "cpp",
      "xtr1common": "cpp",
      "xtree": "cpp",
      "xutility": "cpp",
      "algorithm": "cpp"
    },
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "[html]": {
      "editor.defaultFormatter": null
    },
    "git.confirmSync": false,
    // each project two levels down (core/, addons/, tools/, docs/) is a repo; their vendor/ submodules are not
    "git.detectSubmodules": false,
    "git.autoRepositoryDetection": "subFolders",
    "git.repositoryScanMaxDepth": 2,
    "git.openRepositoryInParentFolders": "never",
    "vsicons.projectDetection.autoReload": true,
    "vsicons.dontShowNewVersionMessage": true,
    "workbench.iconTheme": "vscode-icons",
    "shellcheck.enable": true,
    "shellcheck.useWorkspaceRootAsCwd": true,
    "shellcheck.run": "onSave",
    "shellcheck.enableQuickFix": true,
    "shellcheck.customArgs": [
      "-x",
      "--source-path=SCRIPTDIR"
    ],
    "shellcheck.exclude": [
      "3046",
      "3014",
      "3051"
    ],
    "cmake.configureOnOpen": false,
    "better-comments.multilineComments": true,
    "better-comments.tags": [
      {
        "tag": "!",
        "color": "#FF2D00",
        "strikethrough": false,
        "underline": false,
        "backgroundColor": "transparent",
        "bold": false,
        "italic": false
      },
      {
        "tag": "?",
        "color": "#3498DB",
        "strikethrough": false,
        "underline": false,
        "backgroundColor": "transparent",
        "bold": false,
        "italic": false
      },
      {
        "tag": "//",
        "color": "#474747",
        "strikethrough": true,
        "underline": false,
        "backgroundColor": "transparent",
        "bold": false,
        "italic": false
      },
      {
        "tag": "todo",
        "color": "#FF8C00",
        "strikethrough": false,
        "underline": false,
        "backgroundColor": "transparent",
        "bold": false,
        "italic": false
      },
      {
        "tag": "*",
        "color": "#98C379",
        "strikethrough": false,
        "underline": false,
        "backgroundColor": "transparent",
        "bold": false,
        "italic": false
      }
    ]
  }
}